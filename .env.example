NODE_ENV=development
HOST=127.0.0.1
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=zalo_bot
# Khóa mã hóa phiên Zalo (32 byte, base64). Tạo bằng:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ZALO_CREDENTIALS_KEY=
# Tài khoản Zalo nhận mã đăng nhập trang quản trị (khác tài khoản bot). Đặt một trong hai.
ADMIN_ZALO_PHONE=
ADMIN_ZALO_ID=
